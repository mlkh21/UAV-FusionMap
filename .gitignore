# 本机运行资产；保留catkin目录隔离标记。
/.runtime/*
!/.runtime/CATKIN_IGNORE

# 原有本机会话配置
/.codex/

# ROS构建输出；首选位置为.runtime/ros。
/build/
/ros_ws/build/
/ros_ws/devel/
/ros_ws/install/
/ros_ws/logs/
/ros_ws/.catkin_tools/
/ros_ws/.catkin_workspace
/.catkin_workspace

# Python运行生成物；源码、配置和测试仍逐文件纳入版本管理。
__pycache__/
*.py[cod]

# 测试源码和小型实验记录需要进入逐文件提交审查；运行产物统一位于.runtime。
