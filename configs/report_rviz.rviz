Panels: []
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 29; 35; 38
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Metric Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 160
      Color: 63; 76; 79
      Alpha: 0.5
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: -0.04
      Reference Frame: <Fixed Frame>
    - Class: rviz/MarkerArray
      Name: Public Map / fixture
      Enabled: true
      Marker Topic: /uav/report/markers
      Queue Size: 1
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /uav/report/clicked_point
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 32
      Focal Point:
        X: 45
        Y: 0
        Z: 0.5
      Pitch: 0.68
      Yaw: 0.85
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: []
Window Geometry:
  Width: 1200
  Height: 800
