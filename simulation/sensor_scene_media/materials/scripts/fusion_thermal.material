// Separate visible-color and functional IR-intensity techniques; no temperature units.
material FusionHot
{
  technique
  {
    pass
    {
      ambient 0.7 0.15 0.12
      diffuse 0.8 0.2 0.15
    }
  }
  technique
  {
    scheme FusionThermal
    pass
    {
      lighting on
      ambient 0 0 0
      diffuse 0 0 0
      specular 0 0 0 1
      emissive 0.9 0.9 0.9
    }
  }
}
