    {"id":"forward_doppler","input":{"velocity_mps":[5,0,0],"omega_radps":[0,0,0],"mount_m":[0.8,0,0],"los":[1,0,0]},"expected":{"sensor_velocity_mps":[5,0,0],"doppler_mps":-5}},
    {"id":"angular_lever_arm","input":{"velocity_mps":[5,0,0],"omega_radps":[0,0,1],"mount_m":[0.8,0,0],"los":[0,1,0]},"expected":{"sensor_velocity_mps":[5,0.8,0],"doppler_mps":-0.8}},
    {"id":"geodetic_latitude","input":{"latitude_deg":45,"longitude_deg":0,"geocentric_latitude_deg":44.8,"ecef_delta_ft":[1,0,1]},"expected":{"scene_delta_m":[0,0,0.43105229381131945],"using_geocentric_is_wrong":true}}
